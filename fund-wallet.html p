<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fund Wallet — Hadejia Data Hub</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/voice.css">
<link rel="stylesheet" href="css/nav.css">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

<div class="topbar">
  <a href="dashboard.html">← Back</a>
  <h1>Fund Wallet</h1>
</div>

<div class="page">

  <div class="card balance-card">
    <div class="label">Wallet Balance</div>
    <div class="amount mono" id="wallet-balance">Loading…</div>
  </div>

  <!-- Manual OPay funding -->
  <div class="card" id="opay-account-card">
    <div class="field">
      <label>Transfer to this OPay account</label>
      <div class="plan-option" style="cursor:pointer;" id="opay-account-number-row">
        <div>
          <div class="name mono" id="opay-account-number">Loading…</div>
          <div class="sub" id="opay-bank-name">—</div>
        </div>
        <div class="price" style="font-size:12px;color:var(--teal);">Tap to copy</div>
      </div>
    </div>
    <div class="field">
      <label>Account Name</label>
      <div style="font-size:14px;" id="opay-account-name">—</div>
    </div>
  </div>

  <div class="card" id="opay-form-card">
    <div class="field">
      <label for="opay-amount-input">Amount you transferred (₦)</label>
      <input type="number" id="opay-amount-input" placeholder="e.g. 1000" min="1" step="1">
    </div>
    <div class="field">
      <label for="opay-receipt-input">Upload your receipt (photo/screenshot)</label>
      <input type="file" id="opay-receipt-input" accept="image/*">
    </div>
    <div class="field">
      <label for="opay-note-input">Or type a note instead (e.g. transaction reference)</label>
      <textarea id="opay-note-input" rows="2" placeholder="Optional if you uploaded a receipt above"></textarea>
    </div>
    <button class="btn btn-primary" id="opay-submit-btn">Submit for Review</button>
  </div>

  <div class="empty" id="opay-pending-notice" style="display:none;">
    ✅ Your request has been sent for review. We'll credit your wallet once confirmed — this is usually quick, but can take a little longer outside business hours.
  </div>

  <!--
    ORIGINAL SecureWave dynamic-account cards — kept for easy
    restoration once BVN verification is resolved. js/fund-wallet.js
    keeps the matching original JS in a similar archived block.

  <div class="card" id="amount-card">
    <div class="field">
      <label for="amount-input">Amount to Fund (₦)</label>
      <input type="number" id="amount-input" placeholder="e.g. 1000" min="100" step="1">
    </div>
    <button class="btn btn-primary" id="generate-btn">Generate Transfer Account</button>
  </div>

  <div class="card" id="transfer-card" style="display:none;">
    <div class="field">
      <label>Transfer exactly this amount</label>
      <div class="mono" style="font-size:22px;font-weight:600;color:var(--indigo-deep);" id="tr-amount">₦0.00</div>
    </div>
    <div class="field">
      <label>To this account</label>
      <div class="plan-option" style="cursor:pointer;" id="account-number-row">
        <div>
          <div class="name mono" id="tr-account-number">—</div>
          <div class="sub" id="tr-bank-name">—</div>
        </div>
        <div class="price" style="font-size:12px;color:var(--teal);">Tap to copy</div>
      </div>
    </div>
    <div class="field">
      <label>Account Name</label>
      <div style="font-size:14px;" id="tr-account-name">—</div>
    </div>
    <div class="empty" style="padding:8px 4px;font-size:12px;color:var(--ink-soft);text-align:left;" id="tr-fee-note"></div>
    <div class="empty" id="tr-status">
      ⏳ Waiting for payment… this account expires in <span id="tr-countdown" class="mono">15:00</span>
    </div>
    <button class="btn btn-primary" id="cancel-btn" style="background:var(--paper-dim);color:var(--ink);margin-top:6px;">Cancel / Start Over</button>
  </div>
  -->

</div>

<div class="modal-backdrop" id="result-modal">
  <div class="modal" id="result-modal-content"></div>
</div>

<div id="toast-wrap"></div>

<script src="js/supabase.js"></script>
<script src="js/nav.js"></script>
<script src="js/fund-wallet.js"></script>
</body>
</html>
